---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Sobre mí', href: '/' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Contacto', href: '/contacto' },
];

const isActive = (href: string) => {
  if (href === '/' && (currentPath === '/' || currentPath === '/sobre-mi' || currentPath === '/sobre-mi/')) return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#fafafa]/80 dark:bg-[#08080a]/80 border-b border-neutral-200/80 dark:border-[#1a1a20] transition-colors duration-200">
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Isotipo de Marca a la izquierda -->
    <a
      href="/"
      class="group flex items-center gap-3 text-sm font-semibold tracking-tight text-neutral-900 dark:text-[#f4f4f6] transition-colors"
      aria-label="Ir al inicio"
    >
      <!-- Isotipo Geométrico Monograma RA -->
      <div class="relative flex items-center justify-center w-8 h-8 rounded-lg bg-neutral-100 dark:bg-[#111114] border border-neutral-200 dark:border-[#232328] group-hover:border-[#38bdf8] transition-colors duration-200 shadow-2xs">
        <span class="font-mono text-xs font-bold text-neutral-900 dark:text-[#f4f4f6] tracking-tighter">
          R<span class="text-[#38bdf8]">A</span>
        </span>
        <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full bg-[#0284c7] shadow-[0_0_6px_rgba(2,132,199,0.8)]"></span>
      </div>

      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-900 dark:text-[#f4f4f6] tracking-tight group-hover:text-[#38bdf8] dark:group-hover:text-white transition-colors">
          Richard Assis
        </span>
        <span class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 dark:text-[#63636e]">
          Desarrollo Full Stack
        </span>
      </div>
    </a>

    <!-- Enlaces de navegación desktop + ThemeToggle a la derecha -->
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-6 text-xs font-medium tracking-wide" aria-label="Navegación principal">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class={`transition-colors duration-150 py-1 ${
                active
                  ? 'text-[#0284c7] dark:text-[#38bdf8] font-semibold'
                  : 'text-neutral-600 hover:text-neutral-950 dark:text-[#9e9ea7] dark:hover:text-[#f4f4f6]'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />

        <!-- Botón menú móvil -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 rounded-md border border-neutral-200 dark:border-neutral-800"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <svg class="w-5 h-5 menu-open-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-5 h-5 menu-close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú desplegable móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-neutral-200 dark:border-[#1f1f1f] bg-[#fafafa] dark:bg-[#0c0c0c] px-4 py-4 space-y-3">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block py-2 text-sm ${
          isActive(item.href)
            ? 'text-[#0284c7] dark:text-[#38bdf8] font-semibold'
            : 'text-neutral-600 dark:text-[#9e9ea7] hover:text-neutral-900 dark:hover:text-[#f4f4f6]'
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
  <!-- Barra de progreso de lectura / scroll -->
  <div
    id="scroll-progress-bar"
    class="absolute bottom-0 left-0 h-[2px] bg-gradient-to-r from-[#0369a1] via-[#0284c7] to-[#38bdf8] w-0 transition-[width] duration-75 ease-out pointer-events-none"
  ></div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.menu-open-icon');
  const closeIcon = btn?.querySelector('.menu-close-icon');
  const progressBar = document.getElementById('scroll-progress-bar');

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  const updateScrollProgress = () => {
    const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    if (height > 0 && progressBar) {
      const scrolled = (winScroll / height) * 100;
      progressBar.style.width = scrolled + '%';
    }
  };

  window.addEventListener('scroll', updateScrollProgress, { passive: true });
  updateScrollProgress();
</script>
