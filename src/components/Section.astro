---
interface Props {
  id?: string;
  width?: 'prose' | 'grid' | 'full';
  className?: string;
  spacing?: 'default' | 'compact' | 'none';
}

const {
  id,
  width = 'grid',
  className = '',
  spacing = 'default',
} = Astro.props;

const widthStyles = {
  prose: 'max-w-[720px]',
  grid: 'max-w-[1100px]',
  full: 'max-w-full',
};

const spacingStyles = {
  default: 'py-20 md:py-24',
  compact: 'py-12 md:py-16',
  none: 'py-0',
};
---

<section id={id} class={`w-full px-4 sm:px-6 lg:px-8 mx-auto ${spacingStyles[spacing]} ${className}`}>
  <div class={`w-full mx-auto ${widthStyles[width]}`}>
    <slot />
  </div>
</section>
