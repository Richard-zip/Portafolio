---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Badge from '../components/Badge.astro';

interface Experience {
  role: string;
  company: string;
  period: string;
  current?: boolean;
  type?: string;
  location: string;
  description: string[];
  technologies: string[];
}

// =============================================================================
// LISTA DE EXPERIENCIAS LABORALES
// =============================================================================
const experiences: Experience[] = [
  {
    role: 'Desarrollador de Software Full Stack',
    company: 'Proyectos Independientes',
    period: '2026 — Presente',
    current: true,
    type: 'Desarrollo Profesional',
    location: 'San Pelayo, Córdoba (Presencial / Remoto)',
    description: [
      'Diseño e implementación de arquitectura backend con Java y Spring Boot para APIs RESTful seguras con autenticación JWT.',
      'Desarrollo de interfaces de usuario web con Angular y aplicaciones móviles multiplataforma con Flutter.',
      'Integración de herramientas y APIs de Inteligencia Artificial para enriquecer funcionalidades en aplicaciones.',
      'Modelado relacional y persistencia de datos con PostgreSQL y MySQL bajo estándares ACID.',
      'Contenerización de aplicaciones con Docker y automatización de despliegues en la nube.',
    ],
    technologies: ['Java', 'Spring Boot', 'Angular', 'Flutter', 'PostgreSQL', 'Docker', 'IA APIs', 'Git'],
  },
];

const skills = {
  backend: ['Java', 'Spring Boot', 'Node.js', 'Express', 'Python', 'FastAPI'],
  frontend: ['React', 'Next.js', 'Astro', 'Angular', 'Flutter', 'React Native', 'Electron'],
  databases: ['SQL', 'PostgreSQL', 'MySQL', 'MongoDB'],
  devops: ['Docker', 'AWS', 'Render', 'Git', 'GitHub', 'Scrum'],
  ai: ['APIs de IA', 'OpenAI API', 'Integración en Apps', 'AI Tooling', 'Prompt Engineering'],
};
---

<Layout
  title="Richard Assis | Desarrollador de Software Full Stack"
  description="Biografía profesional, formación en Ingeniería de Software en la Universidad de Cartagena, stack técnico y experiencia como desarrollador full stack."
>
  <Section width="prose" spacing="default" className="pt-12 md:pt-16">
    <!-- Encabezado con Foto y Título -->
    <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-6 sm:gap-8 mb-10">
      <div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-[#f4f4f6]">
          Sobre mí
        </h1>
        <p class="mt-2 text-lg font-mono text-neutral-900 dark:text-[#f4f4f6] font-bold">
          Richard Antonio Assis Trujillo
        </p>
        <p class="text-sm font-mono text-accent dark:text-accent-hover mt-0.5 font-medium">
          Desarrollador de Software Full Stack
        </p>
      </div>

      <!-- Foto de Perfil Circular -->
      <div class="relative group shrink-0 self-start sm:self-center">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-accent/35 to-accent-deep/30 blur-md opacity-70 group-hover:opacity-100 transition duration-300"></div>
        <div class="relative w-28 h-28 sm:w-32 sm:h-32 md:w-36 md:h-36 rounded-full overflow-hidden border-2 border-neutral-200 dark:border-[#1f1f26] bg-[#0f0f12] shadow-lg">
          <img
            src="/images/yo.jpg"
            alt="Richard Antonio Assis Trujillo"
            class="w-full h-full object-cover object-[55%_35%] filter contrast-105 group-hover:scale-105 transition-transform duration-300 ease-out"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <!-- Bio Larga -->
    <div class="space-y-4 text-base text-neutral-600 dark:text-[#9e9ea7] leading-relaxed">
      <p>
        Soy desarrollador de software enfocado en el desarrollo full stack, con experiencia diseñando e implementando soluciones completas, arquitecturas sólidas y aplicaciones web y móviles escalables.
      </p>
      <p>
        Gestiono proyectos completos: análisis de requerimientos, desarrollo frontend y backend, integración de bases de datos, despliegue en la nube, así como el uso e integración de herramientas y APIs de Inteligencia Artificial para crear funcionalidades inteligentes en aplicaciones web y móviles. Actualmente curso Ingeniería de Software en la <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">Universidad de Cartagena</strong>. Estoy disponible para trabajar de forma <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">Presencial y Remota</strong>.
      </p>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f26]" />

    <!-- Experiencia Laboral -->
    <div id="experiencia" class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Experiencia Laboral
        </h2>
        <span class="text-xs font-mono text-neutral-500 dark:text-[#9e9ea7]">
          {experiences.length} {experiences.length === 1 ? 'rol' : 'roles'}
        </span>
      </div>

      <!-- Línea de tiempo vertical -->
      <ol class="relative border-s border-neutral-200 dark:border-[#1f1f26] ml-3 sm:ml-4 space-y-8">
        {experiences.map((exp) => (
          <li class="ms-6 group relative">
            <!-- Indicador en la línea de tiempo -->
            <span
              class={`absolute flex items-center justify-center w-4 h-4 rounded-full -start-[33px] top-2 ring-4 ring-white dark:ring-[#08080a] transition-all ${
                exp.current
                  ? 'bg-accent ring-accent/25'
                  : 'bg-neutral-300 dark:bg-neutral-700'
              }`}
            >
              {exp.current && (
                <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-[#08080a] animate-pulse" />
              )}
            </span>

            <!-- Tarjeta con la información del rol -->
            <div class="p-5 sm:p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-neutral-300 dark:hover:border-accent/40 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <div>
                  <h3 class="text-base font-semibold text-neutral-900 dark:text-[#f4f4f6]">
                    {exp.role}
                  </h3>
                  <div class="flex flex-wrap items-center gap-1.5 text-xs text-neutral-600 dark:text-[#9e9ea7] mt-0.5">
                    <span class="font-medium text-accent dark:text-accent-hover font-mono">
                      {exp.company}
                    </span>
                    {exp.type && (
                      <>
                        <span>•</span>
                        <span>{exp.type}</span>
                      </>
                    )}
                  </div>
                </div>

                <span
                  class={`text-xs font-mono px-2.5 py-0.5 rounded border w-fit whitespace-nowrap self-start sm:self-auto ${
                    exp.current
                      ? 'text-accent dark:text-accent-hover bg-accent/10 border-accent/20 font-semibold'
                      : 'text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 border-neutral-200 dark:border-neutral-700'
                  }`}
                >
                  {exp.period}
                </span>
              </div>

              <p class="text-xs text-neutral-500 dark:text-[#9e9ea7] flex items-center gap-1.5 mb-3">
                <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {exp.location}
              </p>

              <ul class="space-y-1.5 text-xs sm:text-sm text-neutral-600 dark:text-[#9e9ea7] leading-relaxed">
                {exp.description.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent mt-1 shrink-0 font-mono">›</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              {exp.technologies && exp.technologies.length > 0 && (
                <div class="mt-4 pt-3.5 border-t border-neutral-100 dark:border-[#1f1f26] flex flex-wrap gap-1.5">
                  {exp.technologies.map((tech) => (
                    <Badge variant="tech" size="sm">
                      {tech}
                    </Badge>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f26]" />

    <!-- Formación y Educación -->
    <div class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
        <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
        </svg>
        Educación
      </h2>

      <div class="p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
          <h3 class="text-base font-semibold text-neutral-900 dark:text-[#f4f4f6]">
            Ingeniería de Software
          </h3>
          <span class="text-xs font-mono text-accent dark:text-accent-hover bg-accent/10 px-2 py-0.5 rounded border border-accent/20 w-fit">
            Graduación proyectada: Junio 2027
          </span>
        </div>
        <p class="text-sm font-medium text-neutral-600 dark:text-[#9e9ea7]">
          Universidad de Cartagena — Cartagena, Colombia
        </p>
      </div>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f26]" />

    <!-- Stack Técnico por Capas: Bento Grid Moderno -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          Stack Tecnológico
        </h2>
        <span class="text-xs font-mono text-neutral-500 dark:text-[#9e9ea7]">
          Desarrollo Full Stack
        </span>
      </div>

      <!-- Bento Grid Layout -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 1. Card Principal: Backend (Full Width) -->
        <div class="sm:col-span-2 p-6 rounded-2xl border border-accent/30 dark:border-accent/25 bg-gradient-to-br from-accent/[0.04] via-transparent to-accent-deep/[0.02] dark:from-accent-deep/20 dark:via-[#0f0f12] dark:to-[#0f0f12] relative overflow-hidden group hover:border-accent/50 transition-all duration-300 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-hover opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"></span>
              </span>
              <h3 class="text-base font-mono font-bold text-neutral-900 dark:text-[#f4f4f6]">
                Backend & Arquitectura de Software
              </h3>
            </div>
            <span class="font-mono text-[11px] px-2.5 py-0.5 rounded-full bg-accent/10 text-accent dark:text-accent-hover border border-accent/20 font-semibold w-fit">
              Core Specialty
            </span>
          </div>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-[#9e9ea7] leading-relaxed mb-4 max-w-xl">
            Diseño e implementación de microservicios y APIs RESTful de alto rendimiento con Java y el ecosistema Spring Boot. Foco en seguridad (Spring Security + JWT), arquitectura limpia y persistencia robusta.
          </p>

          <div class="flex flex-wrap gap-2">
            {skills.backend.map((item) => (
              <Badge variant="tech" size="md" className="border-accent/20 dark:border-accent/25 font-semibold text-neutral-900 dark:text-neutral-100">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- 2. Frontend & Mobile -->
        <div class="p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-sky-500/40 transition-all duration-300 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-400 shadow-xs shadow-sky-400/50"></span>
              Frontend & Mobile
            </h3>
            <span class="text-[11px] font-mono text-neutral-500 dark:text-[#9e9ea7]">Web / App</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-[#9e9ea7] mb-4 leading-relaxed">
            Interfaces modulares con Angular y TypeScript; experiencias móviles multiplataforma nativas con Flutter.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {skills.frontend.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- 3. Bases de Datos -->
        <div class="p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-indigo-500/40 transition-all duration-300 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-400 shadow-xs shadow-indigo-400/50"></span>
              Bases de Datos
            </h3>
            <span class="text-[11px] font-mono text-neutral-500 dark:text-[#9e9ea7]">SQL / NoSQL</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-[#9e9ea7] mb-4 leading-relaxed">
            Modelado relacional, normalización, optimización de consultas SQL complejas y transacciones ACID.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {skills.databases.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- 4. DevOps & Cloud -->
        <div class="p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-amber-500/40 transition-all duration-300 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400 shadow-xs shadow-amber-400/50"></span>
              DevOps & Cloud
            </h3>
            <span class="text-[11px] font-mono text-neutral-500 dark:text-[#9e9ea7]">CI/CD & Deploy</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-[#9e9ea7] mb-4 leading-relaxed">
            Empaquetado de aplicaciones en contenedores Docker, despliegues en AWS y Render, control de versiones en GitHub y gestión con Scrum.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {skills.devops.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- 5. Inteligencia Artificial & Integración en Apps -->
        <div class="p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-purple-500/40 transition-all duration-300 shadow-xs">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-purple-400 shadow-xs shadow-purple-400/50"></span>
              Inteligencia Artificial & Apps
            </h3>
            <span class="text-[11px] font-mono text-neutral-500 dark:text-[#9e9ea7]">LLMs & APIs</span>
          </div>
          <p class="text-xs text-neutral-600 dark:text-[#9e9ea7] mb-4 leading-relaxed">
            Integración de modelos y APIs de IA en aplicaciones web y móviles para automatización y funciones inteligentes, además del uso de IA en flujos de desarrollo.
          </p>
          <div class="flex flex-wrap gap-1.5">
            {skills.ai.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f26]" />

    <!-- Idiomas y Ubicación -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12]">
        <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] mb-2">
          Idiomas
        </h3>
        <ul class="text-xs font-mono text-neutral-600 dark:text-[#9e9ea7] space-y-1.5">
          <li><strong class="text-neutral-800 dark:text-neutral-200">Español:</strong> Nativo</li>
          <li><strong class="text-neutral-800 dark:text-neutral-200">Inglés:</strong> Básico / Intermedio (lectura técnica)</li>
        </ul>
      </div>

      <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12]">
        <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] mb-2">
          Ubicación & Modalidad
        </h3>
        <ul class="text-xs font-mono text-neutral-600 dark:text-[#9e9ea7] space-y-1.5">
          <li>San Pelayo, Córdoba, Colombia</li>
          <li class="text-accent dark:text-accent-hover font-semibold">• Disponible para trabajar Presencial y Remoto</li>
        </ul>
      </div>
    </div>

    <!-- CTA de contacto -->
    <div class="mt-12 p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f26] bg-neutral-50 dark:bg-[#0f0f12] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-sm font-bold text-neutral-900 dark:text-[#f4f4f6]">
          ¿Interesado en colaborar?
        </h3>
        <p class="text-xs text-neutral-500 dark:text-[#9e9ea7] mt-1">
          Hablemos sobre diseño de APIs, sistemas escalables o desarrollo full-stack.
        </p>
      </div>
      <a
        href="/contacto"
        class="px-4 py-2 rounded-lg text-xs font-mono font-semibold bg-accent text-white hover:bg-accent-hover dark:bg-accent dark:text-white dark:hover:bg-accent-hover transition-colors shadow-xs shadow-accent/20 whitespace-nowrap"
      >
        Ir a Contacto →
      </a>
    </div>
  </Section>
</Layout>
