---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Badge from '../components/Badge.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('proyectos');
const featuredProjects = allProjects.filter((p) => p.data.featured);
const displayProjects = [...featuredProjects];
---

<Layout
  title="Richard Assis | Desarrollador de Software Full Stack (Java / Spring Boot)"
  description="Desarrollador de software especializado en Java + Spring Boot, Angular, Flutter, Docker y AWS. Disponible para trabajar Presencial y Remoto desde San Pelayo / Córdoba, Colombia."
>
  <!-- 1. HERO SECTION -->
  <Section width="prose" spacing="default" className="pt-16 md:pt-24 pb-16">
    <div class="flex flex-col items-start gap-6 animate-fade-in">
      <!-- Badge de disponibilidad Presencial y Remoto -->
      <Badge variant="status" size="md">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1"></span>
        Disponible para trabajar Presencial / Remoto
      </Badge>

      <!-- Encabezado principal y subtítulo -->
      <div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
          Richard Assis
        </h1>
        <p class="mt-2 text-xl sm:text-2xl font-mono text-emerald-600 dark:text-emerald-400 font-medium tracking-tight">
          Desarrollador de Software Full Stack
        </p>
      </div>

      <!-- Bio corta -->
      <p class="text-base sm:text-lg text-neutral-600 dark:text-[#888888] leading-relaxed">
        Desarrollador de software con especialidad en backend con <strong class="text-neutral-900 dark:text-neutral-200 font-medium">Java + Spring Boot</strong> y desarrollo frontend con <strong class="text-neutral-900 dark:text-neutral-200 font-medium">Angular y Flutter</strong>. Construyo APIs REST seguras, sistemas empresariales y despliegues con Docker y AWS.
      </p>

      <!-- Ubicación y formación complementaria técnica -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-mono text-neutral-500 dark:text-neutral-400 pt-1">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          San Pelayo, Córdoba, Colombia (Presencial / Remoto)
        </span>
        <span class="hidden sm:inline">•</span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
          </svg>
          Ing. de Software (U. de Cartagena)
        </span>
      </div>

      <!-- Call to Actions -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="/contacto"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-medium bg-neutral-900 text-white hover:bg-neutral-800 dark:bg-emerald-500 dark:text-neutral-950 dark:hover:bg-emerald-400 font-mono transition-all duration-150 shadow-sm"
        >
          Contactar ahora
          <svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="/sobre-mi"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-medium border border-neutral-300 dark:border-[#262626] bg-transparent text-neutral-800 dark:text-[#e5e5e5] hover:bg-neutral-100 dark:hover:bg-[#161616] font-mono transition-all duration-150"
        >
          Sobre mí
        </a>
      </div>
    </div>
  </Section>

  <!-- 2. MARQUEE DE STACK TÉCNICO -->
  <Marquee />

  <!-- 3. SECCIÓN DE PROYECTOS -->
  <Section id="proyectos-destacados" width="grid" spacing="default">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <span class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold">
          Portafolio
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-[#e5e5e5] mt-1">
          Proyectos destacados
        </h2>
      </div>
      {displayProjects.length > 0 && (
        <a
          href="/proyectos"
          class="inline-flex items-center text-sm font-mono text-neutral-600 dark:text-[#888888] hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
        >
          Explorar todos los proyectos
          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </div>

    <!-- Grid dinámico o estado en preparación -->
    {displayProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {displayProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            stack={project.data.stack}
            year={project.data.year}
            slug={project.id.replace(/\.mdx?$/, '')}
            role={project.data.role}
          />
        ))}
      </div>
    ) : (
      <div class="p-8 sm:p-12 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-800 bg-neutral-50/50 dark:bg-[#0d0d10]/60 text-center max-w-[720px] mx-auto">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 mb-4 border border-emerald-500/20">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-neutral-900 dark:text-[#e5e5e5]">
          Proyectos en proceso de publicación
        </h3>
        <p class="mt-2 text-sm text-neutral-600 dark:text-[#888888] leading-relaxed max-w-md mx-auto">
          Actualmente estoy seleccionando y documentando mis proyectos más destacados con arquitectura detallada. Próximamente estarán publicados aquí.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href="https://github.com/Richard-zip"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-medium bg-neutral-900 text-white dark:bg-emerald-500 dark:text-neutral-950 hover:opacity-90 transition-opacity"
          >
            Ver repositorios en GitHub →
          </a>
          <a
            href="/contacto"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-mono font-medium border border-neutral-300 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-[#161616] transition-colors"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    )}
  </Section>

  <!-- 4. SOBRE MÍ BREVE -->
  <Section id="sobre-mi-resumen" width="prose" spacing="compact" className="border-t border-neutral-200 dark:border-[#1a1a1a]">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2">
        <span class="font-mono text-xs uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold">
          Perfil
        </span>
      </div>
      
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
        Sobre mí
      </h2>

      <div class="space-y-4 text-base text-neutral-600 dark:text-[#888888] leading-relaxed">
        <p>
          Soy desarrollador de software con experiencia diseñando e implementando aplicaciones web y móviles. Me especializo en backend con <strong class="text-neutral-900 dark:text-neutral-200 font-medium">Java + Spring Boot</strong> y desarrollo frontend en <strong class="text-neutral-900 dark:text-neutral-200 font-medium">Angular y Flutter</strong>.
        </p>
        <p>
          Gestiono proyectos completos: análisis de requerimientos, desarrollo, integración de bases de datos, despliegue en la nube y optimización de flujos de trabajo. Estoy disponible para trabajar de forma <strong class="text-neutral-900 dark:text-neutral-200 font-medium">Presencial y Remota</strong>.
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/sobre-mi"
          class="inline-flex items-center gap-1.5 text-sm font-mono font-medium text-emerald-600 dark:text-emerald-400 hover:underline underline-offset-4"
        >
          Leer biografía completa, stack y formación
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </Section>
</Layout>
