---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('proyectos');
// Ordenamos por año descendente si aplica
const sortedProjects = allProjects.sort((a, b) => b.data.year.localeCompare(a.data.year));
---

<Layout
  title="Proyectos | Richard Assis — Backend Software Engineer"
  description="Casos de estudio y aplicaciones en producción construidas con Java, Spring Boot, Angular, Flutter, PostgreSQL y Docker."
>
  <Section width="grid" spacing="default" className="pt-12 md:pt-16">
    <!-- Encabezado de la página -->
    <div class="max-w-[720px] mb-12">
      <Badge variant="accent" size="sm" className="mb-4">
        Casos de estudio
      </Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
        Proyectos de Software
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-[#888888] leading-relaxed">
        Soluciones backend y full-stack diseñadas con foco en consistencia de datos, seguridad, APIs REST documentadas y despliegue en contenedores.
      </p>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          stack={project.data.stack}
          year={project.data.year}
          slug={project.id.replace(/\.mdx?$/, '')}
          role={project.data.role}
        />
      ))}

      <!-- Próximo caso de estudio / Tarjeta informativa -->
      <div class="flex flex-col justify-between p-6 md:p-7 rounded-xl border border-dashed border-neutral-300 dark:border-neutral-800 bg-neutral-50/50 dark:bg-[#0d0d0d]/50">
        <div>
          <span class="font-mono text-xs text-neutral-400 dark:text-neutral-500">
            Roadmap 2025
          </span>
          <h3 class="mt-3 text-lg font-semibold text-neutral-800 dark:text-neutral-200">
            [COMPLETAR: Nuevo Microservicio / Arquitectura Cloud]
          </h3>
          <p class="mt-2 text-sm text-neutral-500 dark:text-[#777777] leading-relaxed">
            Próximo proyecto documentado enfocado en mensajería asíncrona, orquestación y despliegue en AWS / Render.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-neutral-200/60 dark:border-neutral-800/60 flex items-center justify-between text-xs font-mono text-neutral-400">
          <span>En fase de diseño</span>
          <span class="text-emerald-500 font-semibold">• Activo</span>
        </div>
      </div>
    </div>
  </Section>
</Layout>
