---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Badge from '../../components/Badge.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('proyectos');
const sortedProjects = allProjects.sort((a, b) => b.data.year.localeCompare(a.data.year));
---

<Layout
  title="Proyectos | Richard Antonio Assis Trujillo — Desarrollador Full Stack"
  description="Casos de estudio, arquitectura y proyectos de software en Java, Spring Boot, Angular, Flutter, Docker y AWS."
>
  <Section width="grid" spacing="default" className="pt-12 md:pt-16">
    <!-- Encabezado de la página -->
    <div class="max-w-[720px] mb-12">
      <Badge variant="accent" size="sm" className="mb-4">
        Casos de estudio
      </Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
        Proyectos de Software
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-[#888888] leading-relaxed">
        Soluciones backend y full-stack diseñadas con foco en consistencia de datos, seguridad, APIs REST documentadas y despliegue en contenedores.
      </p>
    </div>

    <!-- Grid de proyectos o estado de preparación -->
    {sortedProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            stack={project.data.stack}
            year={project.data.year}
            slug={project.id.replace(/\.mdx?$/, '')}
            role={project.data.role}
          />
        ))}
      </div>
    ) : (
      <div class="p-8 sm:p-12 rounded-2xl border border-dashed border-neutral-300 dark:border-neutral-800 bg-neutral-50/50 dark:bg-[#0d0d10]/60 text-center max-w-[720px] mx-auto">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 mb-4 border border-emerald-500/20">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-neutral-900 dark:text-[#e5e5e5]">
          Proyectos en proceso de documentación
        </h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-[#888888] leading-relaxed max-w-md mx-auto">
          Próximamente se publicarán aquí los casos de estudio completos con diagramas visuales de arquitectura, decisiones técnicas y enlaces a repositorios.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href="https://github.com/Richard-zip"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-xs font-mono font-medium bg-neutral-900 text-white dark:bg-emerald-500 dark:text-neutral-950 hover:opacity-90 transition-opacity"
          >
            Explorar repositorios en GitHub →
          </a>
          <a
            href="/contacto"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-xs font-mono font-medium border border-neutral-300 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-[#161616] transition-colors"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    )}
  </Section>
</Layout>
