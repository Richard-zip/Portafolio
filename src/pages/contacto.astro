---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Badge from '../components/Badge.astro';

const contactInfo = [
  {
    channel: 'WhatsApp / Teléfono',
    value: '+57 317 271 9261',
    href: 'https://wa.me/573172719261',
    actionText: 'Escribir por WhatsApp →',
    description: 'Respuesta inmediata. Ideal para consultas rápidas de proyectos o disponibilidad.',
    icon: 'whatsapp',
    highlight: true,
  },
  {
    channel: 'Email Directo',
    value: 'richardantonioassistrujillo@gmail.com',
    href: 'mailto:richardantonioassistrujillo@gmail.com',
    actionText: 'Enviar correo →',
    description: 'Para propuestas formales, especificaciones técnicas o vacantes laborales.',
    icon: 'mail',
    highlight: false,
  },
  {
    channel: 'LinkedIn',
    value: 'linkedin.com/in/richard-assis',
    href: 'https://linkedin.com/in/richard-assis',
    actionText: 'Ver perfil profesional →',
    description: 'Red profesional, trayectoria y recomendaciones.',
    icon: 'linkedin',
    highlight: false,
  },
  {
    channel: 'GitHub',
    value: 'github.com/Richard-zip',
    href: 'https://github.com/Richard-zip',
    actionText: 'Explorar repositorios →',
    description: 'Código fuente de proyectos, commits y contribuciones abiertas.',
    icon: 'github',
    highlight: false,
  },
];
---

<Layout
  title="Contacto | Richard Antonio Assis Trujillo — Desarrollador Full Stack"
  description="Ponte en contacto directo con Richard Assis por WhatsApp, Email o LinkedIn para proyectos de software, APIs REST y desarrollo full-stack."
>
  <Section width="prose" spacing="default" className="pt-12 md:pt-16">
    <!-- Encabezado -->
    <div class="mb-10">
      <Badge variant="status" size="sm" className="mb-4">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1"></span>
        Disponible para trabajar Presencial y Remoto
      </Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
        Contacto directo
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-[#888888] leading-relaxed">
        ¿Tienes un proyecto en mente, necesitas construir una API REST en Java/Spring Boot o buscas apoyo en desarrollo full-stack? Escríbeme directamente por cualquiera de estos canales:
      </p>
    </div>

    <!-- Canales de contacto directo -->
    <div class="space-y-4 mb-12">
      <!-- 1. Hero Card: WhatsApp (Canal Prioritario) -->
      <a
        href="https://wa.me/573172719261"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative block p-6 sm:p-7 rounded-2xl border-2 border-emerald-500/40 dark:border-emerald-500/30 bg-gradient-to-br from-emerald-500/[0.07] via-emerald-500/[0.02] to-transparent dark:from-emerald-950/25 dark:via-[#111111] dark:to-[#111111] hover:border-emerald-500 dark:hover:border-emerald-400 transition-all duration-200 shadow-md hover:shadow-emerald-500/10 overflow-hidden"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2.5">
            <!-- Icono WhatsApp SVG -->
            <div class="p-2 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.115.549 4.101 1.509 5.828l-1.609 5.872 6.014-1.578c1.669.914 3.585 1.438 5.626 1.438 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                WhatsApp / Teléfono Directo
              </span>
              <span class="inline-flex items-center gap-1 ml-2 text-[11px] font-mono font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Recomendado
              </span>
            </div>
          </div>
          <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
            Escribir por WhatsApp →
          </span>
        </div>

        <div class="text-xl sm:text-2xl font-bold font-mono text-neutral-900 dark:text-[#e5e5e5] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          +57 317 271 9261
        </div>

        <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-[#888888] leading-relaxed">
          Respuesta inmediata. Canal principal y más ágil para proyectos, consultas técnicas o disponibilidad.
        </p>
      </a>

      <!-- 2. Email Directo -->
      <a
        href="mailto:richardantonioassistrujillo@gmail.com"
        class="group block p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111] hover:border-neutral-400 dark:hover:border-neutral-700 transition-all duration-200 shadow-xs"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              Email Directo
            </span>
          </div>
          <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 group-hover:text-emerald-500 group-hover:translate-x-1 transition-all inline-flex items-center gap-1 font-medium">
            Enviar correo →
          </span>
        </div>
        <div class="text-base sm:text-lg font-bold font-mono text-neutral-900 dark:text-[#e5e5e5] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors break-all sm:break-normal">
          richardantonioassistrujillo@gmail.com
        </div>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-[#888888] leading-relaxed">
          Para propuestas formales, especificaciones de arquitectura técnica o vacantes laborales.
        </p>
      </a>

      <!-- 3. LinkedIn -->
      <a
        href="https://linkedin.com/in/richard-assis"
        target="_blank"
        rel="noopener noreferrer"
        class="group block p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111] hover:border-sky-500/40 transition-all duration-200 shadow-xs"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              LinkedIn
            </span>
          </div>
          <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 group-hover:text-sky-500 group-hover:translate-x-1 transition-all inline-flex items-center gap-1 font-medium">
            Ver perfil profesional →
          </span>
        </div>
        <div class="text-base sm:text-lg font-bold font-mono text-neutral-900 dark:text-[#e5e5e5] group-hover:text-sky-500 transition-colors">
          linkedin.com/in/richard-assis
        </div>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-[#888888] leading-relaxed">
          Red profesional, trayectoria y recomendaciones.
        </p>
      </a>

      <!-- 4. GitHub -->
      <a
        href="https://github.com/Richard-zip"
        target="_blank"
        rel="noopener noreferrer"
        class="group block p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111] hover:border-neutral-400 dark:hover:border-neutral-700 transition-all duration-200 shadow-xs"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              GitHub
            </span>
          </div>
          <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400 group-hover:text-emerald-500 group-hover:translate-x-1 transition-all inline-flex items-center gap-1 font-medium">
            Explorar repositorios →
          </span>
        </div>
        <div class="text-base sm:text-lg font-bold font-mono text-neutral-900 dark:text-[#e5e5e5] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
          github.com/Richard-zip
        </div>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-[#888888] leading-relaxed">
          Código fuente de proyectos, commits y contribuciones abiertas.
        </p>
      </a>
    </div>

    <!-- Ficha informativa de disponibilidad y condiciones -->
    <div class="p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-neutral-50 dark:bg-[#0c0c0e]">
      <h2 class="text-sm font-mono font-semibold text-neutral-900 dark:text-neutral-200 uppercase tracking-wider mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Disponibilidad y Condiciones
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono text-neutral-600 dark:text-[#888888]">
        <div>
          <span class="block text-neutral-400 dark:text-neutral-500">Ubicación y Modalidad</span>
          <span class="text-neutral-900 dark:text-neutral-200 font-medium">San Pelayo, Colombia • Presencial / Remoto</span>
        </div>
        <div>
          <span class="block text-neutral-400 dark:text-neutral-500">Zona Horaria</span>
          <span class="text-neutral-900 dark:text-neutral-200 font-medium">UTC-5 (America/Bogota)</span>
        </div>
        <div>
          <span class="block text-neutral-400 dark:text-neutral-500">Tiempo de Respuesta</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-medium">Inmediato en WhatsApp / &lt; 24h Email</span>
        </div>
        <div>
          <span class="block text-neutral-400 dark:text-neutral-500">Tipo de Contratación</span>
          <span class="text-neutral-900 dark:text-neutral-200 font-medium">Freelance por proyecto / Tiempo completo</span>
        </div>
      </div>
    </div>
  </Section>
</Layout>
