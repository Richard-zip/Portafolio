---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Badge from '../components/Badge.astro';

const contactInfo = [
  {
    channel: 'Email Directo',
    value: 'richardantonioassistrujillo@gmail.com',
    href: 'mailto:richardantonioassistrujillo@gmail.com',
    actionText: 'Enviar correo →',
    description: 'Canal principal para propuestas formales, especificaciones técnicas o vacantes laborales.',
    icon: 'mail',
    highlight: true,
  },
  {
    channel: 'LinkedIn',
    value: 'linkedin.com/in/richard-assis',
    href: 'https://linkedin.com/in/richard-assis',
    actionText: 'Ver perfil profesional →',
    description: 'Red profesional, trayectoria y recomendaciones.',
    icon: 'linkedin',
    highlight: false,
  },
  {
    channel: 'GitHub',
    value: 'github.com/Richard-zip',
    href: 'https://github.com/Richard-zip',
    actionText: 'Explorar repositorios →',
    description: 'Código fuente de proyectos, commits y contribuciones abiertas.',
    icon: 'github',
    highlight: false,
  },
];
---

<Layout
  title="Contacto | Richard Antonio Assis Trujillo — Desarrollador Full Stack"
  description="Ponte en contacto directo con Richard Assis por Email o LinkedIn para proyectos de software y desarrollo full-stack."
>
  <Section width="prose" spacing="default" className="pt-12 md:pt-16">
    <!-- Encabezado -->
    <div class="mb-10">
      <Badge variant="status" size="sm" className="mb-4">
        <span class="inline-block w-2 h-2 rounded-full bg-[#0284c7] animate-pulse mr-1"></span>
        Disponible para trabajar Presencial y Remoto
      </Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-neutral-900 dark:text-[#f4f4f6]">
        Contacto directo
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-[#9e9ea7] leading-relaxed">
        ¿Tienes un proyecto en mente, necesitas desarrollo full stack o buscas incorporar a un desarrollador a tu equipo? Escríbeme directamente por cualquiera de estos canales:
      </p>
    </div>

    <!-- Canales de contacto directo -->
    <div class="space-y-4 mb-12">
      <!-- 1. Hero Card: Email Directo (Canal Principal y Seguro) -->
      <a
        href="mailto:richardantonioassistrujillo@gmail.com"
        class="group relative block p-6 sm:p-7 rounded-2xl border-2 border-[#0284c7]/40 hover:border-[#38bdf8] bg-gradient-to-br from-[#0284c7]/[0.08] via-transparent to-transparent dark:from-[#0369a1]/15 dark:via-[#0f0f12] dark:to-[#0f0f12] transition-all duration-200 shadow-md hover:shadow-[0_0_24px_rgba(56,189,248,0.12)] overflow-hidden"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-[#0284c7]/15 text-[#38bdf8] border border-[#0284c7]/30">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#38bdf8]">
                Email Directo
              </span>
              <span class="inline-flex items-center gap-1 ml-2 text-[11px] font-mono font-semibold text-[#38bdf8] bg-[#0c2333] px-2 py-0.5 rounded-full border border-[#0284c7]/40">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0284c7] shadow-[0_0_6px_rgba(2,132,199,0.8)]"></span>
                Canal Principal
              </span>
            </div>
          </div>
          <span class="text-xs font-mono text-[#38bdf8] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
            Enviar correo directo →
          </span>
        </div>

        <div class="text-lg sm:text-xl md:text-2xl font-bold font-mono text-neutral-900 dark:text-[#f4f4f6] group-hover:text-[#38bdf8] transition-colors break-all">
          richardantonioassistrujillo@gmail.com
        </div>

        <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-[#9e9ea7] leading-relaxed">
          Respuesta ágil. Canal preferido para requerimientos técnicos, especificaciones y vacantes de contratación.
        </p>
      </a>

      <!-- 3. LinkedIn -->
      <a
        href="https://linkedin.com/in/richard-assis"
        target="_blank"
        rel="noopener noreferrer"
        class="group block p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-sky-500/40 transition-all duration-200 shadow-xs"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-sky-500/10 text-sky-500 dark:text-sky-400">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 dark:text-[#63636e]">
              LinkedIn
            </span>
          </div>
          <span class="text-xs font-mono text-neutral-500 dark:text-[#9e9ea7] group-hover:text-sky-400 group-hover:translate-x-1 transition-all inline-flex items-center gap-1 font-medium">
            Ver perfil profesional →
          </span>
        </div>
        <div class="text-base sm:text-lg font-bold font-mono text-neutral-900 dark:text-[#f4f4f6] group-hover:text-sky-400 transition-colors">
          linkedin.com/in/richard-assis
        </div>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-[#9e9ea7] leading-relaxed">
          Red profesional, trayectoria y recomendaciones.
        </p>
      </a>

      <!-- 4. GitHub -->
      <a
        href="https://github.com/Richard-zip"
        target="_blank"
        rel="noopener noreferrer"
        class="group block p-5 sm:p-6 rounded-2xl border border-neutral-200 dark:border-[#1f1f26] bg-white dark:bg-[#0f0f12] hover:border-[#33333d] transition-all duration-200 shadow-xs"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-2">
          <div class="flex items-center gap-2.5">
            <div class="p-2 rounded-lg bg-neutral-100 dark:bg-[#16161b] text-neutral-700 dark:text-[#c4c4cc]">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </div>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 dark:text-[#63636e]">
              GitHub
            </span>
          </div>
          <span class="text-xs font-mono text-neutral-500 dark:text-[#9e9ea7] group-hover:text-[#38bdf8] group-hover:translate-x-1 transition-all inline-flex items-center gap-1 font-medium">
            Explorar repositorios →
          </span>
        </div>
        <div class="text-base sm:text-lg font-bold font-mono text-neutral-900 dark:text-[#f4f4f6] group-hover:text-[#38bdf8] transition-colors">
          github.com/Richard-zip
        </div>
        <p class="mt-2 text-xs sm:text-sm text-neutral-500 dark:text-[#9e9ea7] leading-relaxed">
          Código fuente de proyectos, commits y contribuciones abiertas.
        </p>
      </a>
    </div>

    <!-- Ficha informativa de disponibilidad y condiciones -->
    <div class="p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f26] bg-neutral-50 dark:bg-[#0f0f12]">
      <h2 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#f4f4f6] uppercase tracking-wider mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-[#38bdf8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Disponibilidad y Condiciones
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono text-neutral-600 dark:text-[#9e9ea7]">
        <div>
          <span class="block text-neutral-400 dark:text-[#63636e]">Ubicación y Modalidad</span>
          <span class="text-neutral-900 dark:text-[#f4f4f6] font-medium">San Pelayo, Colombia • Presencial / Remoto</span>
        </div>
        <div>
          <span class="block text-neutral-400 dark:text-[#63636e]">Zona Horaria</span>
          <span class="text-neutral-900 dark:text-[#f4f4f6] font-medium">UTC-5 (America/Bogota)</span>
        </div>
        <div>
          <span class="block text-neutral-400 dark:text-[#63636e]">Tiempo de Respuesta</span>
          <span class="text-[#0284c7] dark:text-[#38bdf8] font-medium">&lt; 24h por Email / LinkedIn</span>
        </div>
        <div>
          <span class="block text-neutral-400 dark:text-[#63636e]">Tipo de Contratación</span>
          <span class="text-neutral-900 dark:text-[#f4f4f6] font-medium">Contrato por proyecto / Tiempo completo</span>
        </div>
      </div>
    </div>
  </Section>
</Layout>
