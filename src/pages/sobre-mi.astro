---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Badge from '../components/Badge.astro';

interface Experience {
  role: string;
  company: string;
  period: string;
  current?: boolean;
  type?: string;
  location: string;
  description: string[];
  technologies: string[];
}

// =============================================================================
// LISTA DE EXPERIENCIAS LABORALES
// Para agregar una nueva experiencia en el futuro, simplemente añade un nuevo
// objeto a este array. La línea de tiempo se ajusta automáticamente manteniendo
// el diseño limpio y ordenado sin importar cuántas experiencias tengas.
// =============================================================================
const experiences: Experience[] = [
  {
    role: 'Desarrollador de Software Full Stack',
    company: 'Proyectos Independientes',
    period: '2026 — Presente',
    current: true,
    type: 'Freelance & Consultoría',
    location: 'San Pelayo, Córdoba (Presencial / Remoto)',
    description: [
      'Diseño e implementación de arquitectura backend con Java y Spring Boot para APIs RESTful seguras con autenticación JWT.',
      'Desarrollo de interfaces de usuario web con Angular y aplicaciones móviles multiplataforma con Flutter.',
      'Modelado relacional y persistencia de datos con PostgreSQL y MySQL bajo estándares ACID.',
      'Contenerización de aplicaciones con Docker y automatización de despliegues en la nube.',
    ],
    technologies: ['Java', 'Spring Boot', 'Angular', 'Flutter', 'PostgreSQL', 'Docker', 'Git'],
  },
  {
    role: 'Desarrollador Backend Java',
    company: 'Soluciones Digitales S.A.S.',
    period: '2025 — 2026',
    current: false,
    type: 'Contrato Remoto',
    location: 'Montería / Remoto',
    description: [
      'Construcción y mantenimiento de microservicios en Java con Spring Boot y Spring Data JPA.',
      'Diseño de endpoints REST con validaciones estrictas, manejo centralizado de excepciones y documentación OpenAPI.',
      'Optimización de consultas SQL en PostgreSQL reduciendo tiempos de respuesta en reportes.',
      'Implementación de pruebas unitarias y de integración con JUnit 5 y Mockito.',
    ],
    technologies: ['Java', 'Spring Boot', 'PostgreSQL', 'JUnit', 'Mockito', 'Docker'],
  },
  {
    role: 'Desarrollador Frontend & Móvil',
    company: 'Proyectos Académicos y Colaborativos',
    period: '2024 — 2025',
    current: false,
    type: 'Freelance',
    location: 'Cartagena / San Pelayo (Presencial)',
    description: [
      'Desarrollo de interfaces interactivas y modulares con Angular, TypeScript y Tailwind CSS.',
      'Construcción de aplicaciones móviles multiplataforma con Flutter para consumo de APIs REST.',
      'Control de versiones en Git/GitHub bajo flujos de trabajo colaborativos y revisiones de código.',
    ],
    technologies: ['Angular', 'Flutter', 'TypeScript', 'Tailwind CSS', 'Git'],
  },
];

const skills = {
  backend: ['Java', 'Spring Boot', 'Node.js', 'Python', 'Laravel'],
  frontend: ['Angular', 'React', 'Flutter', 'React Native', 'Electron'],
  databases: ['PostgreSQL', 'MySQL', 'MongoDB'],
  devops: ['Docker', 'AWS', 'Render', 'Git', 'GitHub', 'Scrum'],
};
---

<Layout
  title="Sobre mí | Richard Assis — Backend Software Engineer"
  description="Biografía profesional, formación en Ingeniería de Software en la Universidad de Cartagena, stack técnico y experiencia como desarrollador."
>
  <Section width="prose" spacing="default" className="pt-12 md:pt-16">
    <!-- Encabezado con Foto y Título -->
    <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-6 sm:gap-8 mb-10">
      <div>
        <Badge variant="accent" size="sm" className="mb-4">
          Perfil Profesional
        </Badge>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
          Sobre mí
        </h1>
        <p class="mt-2 text-lg font-mono text-emerald-600 dark:text-emerald-400">
          Richard Antonio Assis Trujillo
        </p>
        <p class="text-sm font-mono text-neutral-500 dark:text-neutral-400 mt-0.5">
          Desarrollador de Software Full Stack
        </p>
      </div>

      <!-- Foto de Perfil Circular -->
      <div class="relative group shrink-0 self-start sm:self-center">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-emerald-500/25 to-teal-500/20 blur-md opacity-70 group-hover:opacity-100 transition duration-300"></div>
        <div class="relative w-28 h-28 sm:w-32 sm:h-32 md:w-36 md:h-36 rounded-full overflow-hidden border-2 border-neutral-200 dark:border-[#262626] bg-[#111111] shadow-lg">
          <img
            src="/images/yo.jpg"
            alt="Richard Antonio Assis Trujillo"
            class="w-full h-full object-cover object-[55%_35%] filter contrast-105 group-hover:scale-105 transition-transform duration-300 ease-out"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <!-- Bio Larga -->
    <div class="space-y-4 text-base text-neutral-600 dark:text-[#888888] leading-relaxed">
      <p>
        Soy desarrollador de software freelance con experiencia diseñando e implementando aplicaciones web y móviles. Me especializo en backend con <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">Java + Spring Boot</strong> y complemento con frontend en <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">Angular y Flutter</strong>.
      </p>
      <p>
        Gestiono proyectos completos: análisis de requerimientos, desarrollo, integración de bases de datos, despliegue en la nube y uso de IA para optimizar el flujo de trabajo. Actualmente curso Ingeniería de Software en la <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">Universidad de Cartagena</strong>. Estoy disponible para trabajar de forma <strong class="text-neutral-900 dark:text-neutral-200 font-semibold">Presencial y Remota</strong>.
      </p>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f1f]" />

    <!-- Experiencia Laboral -->
    <div id="experiencia" class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-[#e5e5e5] flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Experiencia Laboral
        </h2>
        <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
          {experiences.length} {experiences.length === 1 ? 'rol' : 'roles'}
        </span>
      </div>

      <!-- Línea de tiempo vertical -->
      <ol class="relative border-s border-neutral-200 dark:border-[#222222] ml-3 sm:ml-4 space-y-8">
        {experiences.map((exp) => (
          <li class="ms-6 group relative">
            <!-- Indicador en la línea de tiempo -->
            <span
              class={`absolute flex items-center justify-center w-4 h-4 rounded-full -start-[33px] top-2 ring-4 ring-white dark:ring-[#0a0a0a] transition-all ${
                exp.current
                  ? 'bg-emerald-500 ring-emerald-500/20'
                  : 'bg-neutral-300 dark:bg-neutral-700'
              }`}
            >
              {exp.current && (
                <span class="w-1.5 h-1.5 rounded-full bg-white dark:bg-[#0a0a0a] animate-pulse" />
              )}
            </span>

            <!-- Tarjeta con la información del rol -->
            <div class="p-5 sm:p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111] hover:border-neutral-300 dark:hover:border-[#2b2b2b] transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <div>
                  <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
                    {exp.role}
                  </h3>
                  <div class="flex flex-wrap items-center gap-1.5 text-xs text-neutral-600 dark:text-neutral-400 mt-0.5">
                    <span class="font-medium text-emerald-600 dark:text-emerald-400 font-mono">
                      {exp.company}
                    </span>
                    {exp.type && (
                      <>
                        <span>•</span>
                        <span>{exp.type}</span>
                      </>
                    )}
                  </div>
                </div>

                <span
                  class={`text-xs font-mono px-2.5 py-0.5 rounded border w-fit whitespace-nowrap self-start sm:self-auto ${
                    exp.current
                      ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border-emerald-500/20 font-semibold'
                      : 'text-neutral-600 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800 border-neutral-200 dark:border-neutral-700'
                  }`}
                >
                  {exp.period}
                </span>
              </div>

              <p class="text-xs text-neutral-500 dark:text-neutral-400 flex items-center gap-1.5 mb-3">
                <svg class="w-3.5 h-3.5 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {exp.location}
              </p>

              <ul class="space-y-1.5 text-xs sm:text-sm text-neutral-600 dark:text-[#888888] leading-relaxed">
                {exp.description.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-500 mt-1 shrink-0 font-mono">›</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              {exp.technologies && exp.technologies.length > 0 && (
                <div class="mt-4 pt-3.5 border-t border-neutral-100 dark:border-[#1a1a1a] flex flex-wrap gap-1.5">
                  {exp.technologies.map((tech) => (
                    <Badge variant="tech" size="sm">
                      {tech}
                    </Badge>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f1f]" />

    <!-- Formación y Educación -->
    <div class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-[#e5e5e5] flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
        </svg>
        Educación
      </h2>

      <div class="p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
            Ingeniería de Software
          </h3>
          <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 w-fit">
            Graduación proyectada: Junio 2027
          </span>
        </div>
        <p class="text-sm font-medium text-neutral-600 dark:text-neutral-400">
          Universidad de Cartagena — Cartagena, Colombia
        </p>
        <p class="mt-3 text-xs text-neutral-500 dark:text-[#888888] leading-relaxed">
          Formación universitaria sólida en algoritmos, estructuras de datos, patrones de diseño de software, modelado de bases de datos relacionales y arquitectura de sistemas distribuidos.
        </p>
      </div>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f1f]" />

    <!-- Stack Técnico por Capas -->
    <div class="space-y-8">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-[#e5e5e5]">
        Stack Tecnológico
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Backend -->
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
          <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#e5e5e5] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Backend (Especialidad)
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skills.backend.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- Frontend -->
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
          <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#e5e5e5] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
            Frontend & Mobile
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skills.frontend.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- Bases de datos -->
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
          <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#e5e5e5] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Bases de Datos
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skills.databases.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>

        <!-- DevOps & Metodologías -->
        <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
          <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#e5e5e5] mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            DevOps & Herramientas
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {skills.devops.map((item) => (
              <Badge variant="tech" size="sm">
                {item}
              </Badge>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Separador -->
    <hr class="my-12 border-neutral-200 dark:border-[#1f1f1f]" />

    <!-- Idiomas y Ubicación -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
        <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#e5e5e5] mb-2">
          Idiomas
        </h3>
        <ul class="text-xs font-mono text-neutral-600 dark:text-[#888888] space-y-1.5">
          <li><strong class="text-neutral-800 dark:text-neutral-300">Español:</strong> Nativo</li>
          <li><strong class="text-neutral-800 dark:text-neutral-300">Inglés:</strong> Básico / Intermedio (lectura técnica)</li>
        </ul>
      </div>

      <div class="p-5 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-white dark:bg-[#111111]">
        <h3 class="text-sm font-mono font-semibold text-neutral-900 dark:text-[#e5e5e5] mb-2">
          Ubicación & Modalidad
        </h3>
        <ul class="text-xs font-mono text-neutral-600 dark:text-[#888888] space-y-1.5">
          <li>San Pelayo, Córdoba, Colombia</li>
          <li class="text-emerald-600 dark:text-emerald-400 font-semibold">• Disponible para trabajar Presencial y Remoto</li>
        </ul>
      </div>
    </div>

    <!-- CTA de contacto -->
    <div class="mt-12 p-6 rounded-xl border border-neutral-200 dark:border-[#1f1f1f] bg-neutral-50 dark:bg-[#0d0d0d] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">
          ¿Interesado en colaborar?
        </h3>
        <p class="text-xs text-neutral-500 dark:text-[#888888] mt-1">
          Hablemos sobre diseño de APIs, sistemas de backend o desarrollo full-stack.
        </p>
      </div>
      <a
        href="/contacto"
        class="px-4 py-2 rounded-lg text-xs font-mono font-semibold bg-neutral-900 text-white dark:bg-emerald-500 dark:text-neutral-950 hover:opacity-90 transition-opacity whitespace-nowrap"
      >
        Ir a Contacto →
      </a>
    </div>
  </Section>
</Layout>
